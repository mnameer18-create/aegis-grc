      "id": "q-search",
      "name": "Retrieve Regulatory Evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -40,
        -70
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows=$input.first().json;\nconst query=$('Validate RAG Question').first().json;\nconst sources=Array.isArray(rows)?rows:[];\nif(!sources.length){\n  return [{json:{has_sources:false,http_status:200,response:{answer:'I could not find sufficiently relevant evidence in the approved Aegis regulatory knowledge base for this question. Review the authoritative source documents or broaden the indexed library before making a compliance decision.',mode:'grounded_rag',sources:[],regulatory_sources_verified:false,human_review_required:true,request_id:query.request_id}}}];\n}\nconst cited=sources.map((s,i)=>({\n  citation_id:'S'+(i+1),\n  document_title:s.document_title,\n  source_org:s.source_org,\n  source_url:s.source_url,\n  version_label:s.version_label,\n  effective_date:s.effective_date,\n  page_number:s.page_number,\n  section_title:s.section_title,\n  similarity:Number(s.similarity||0),\n  content:s.content\n}));\nconst context=cited.map(s=>`[${s.citation_id}] ${s.document_title}${s.version_label?' | Version '+s.version_label:''}${s.page_number?' | Page '+s.page_number:''}${s.section_title?' | '+s.section_title:''}\\n${s.content}`).join('\\n\\n---\\n\\n');\nconst payload={\n  model:'gpt-4.1-mini',\n  temperature:0.1,\n  max_tokens:800,\n  messages:[\n    {role:'system',content:'You are Aegis Regulatory Intelligence. Answer ONLY from the supplied retrieved evidence. Every material regulatory statement must cite one or more source IDs exactly like [S1]. Do not invent regulations, clauses, deadlines, policy names or facts. If the evidence is incomplete or conflicting, say so explicitly. Distinguish evidence from interpretation. Never make an autonomous compliance approval, closure or regulatory submission. End with a short Human review section identifying what an authorised Compliance Officer should verify.'},\n    {role:'user',content:'Question: '+query.question+'\\n\\nRetrieved evidence:\\n'+context}\n  ]\n};\nreturn [{json:{has_sources:true,question:query.question,request_id:query.request_id,sources:cited.map(({content,...rest})=>rest),payload}}];"
      },
