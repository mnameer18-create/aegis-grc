    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const src=$input.first().json;\nconst body=src.body&&typeof src.body==='object'&&!Array.isArray(src.body)?src.body:{};\nconst question=typeof body.question==='string'?body.question.trim():'';\nconst requestId='aegis-rag-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,8);\nif(!question||question.length>2000){\n  return [{json:{valid:false,http_status:400,response:{error:'question must be a non-empty string of at most 2000 characters',request_id:requestId}}}];\n}\nreturn [{json:{valid:true,question,request_id:requestId}}];"
      },
      "id": "q-validate",
      "name": "Validate RAG Question",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -740,
        40
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "q-valid-cond",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
