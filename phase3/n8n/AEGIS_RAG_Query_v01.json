        "mode": "runOnceForAllItems",
        "jsCode": "const api=$input.first().json;\nconst request=$('Build Grounded Prompt').first().json;\nconst answer=api?.choices?.[0]?.message?.content;\nif(typeof answer!=='string'||!answer.trim()){\n  return [{json:{http_status:502,response:{error:'The LLM returned no usable grounded answer',request_id:request.request_id}}}];\n}\nreturn [{json:{http_status:200,response:{answer:answer.trim(),mode:'grounded_rag',sources:request.sources,regulatory_sources_verified:true,human_review_required:true,request_id:request.request_id,model:api.model||'provider_model'}}}];"
