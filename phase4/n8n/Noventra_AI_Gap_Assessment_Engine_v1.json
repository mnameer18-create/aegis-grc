    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'gpt-4o-mini',temperature:0,response_format:{type:'json_object'},messages:[{role:'system',content:'You are the Noventra compliance gap assessment engine. Compare every supplied BNM regulatory clause against the supplied internal policy, SOP, OSOPM or process sections. Return one JSON object with overall_outcome, summary, and findings. Produce exactly one finding for every regulatory clause. Each finding must contain regulatory_clause_id, internal_document_section_id or null, proposed_outcome (compliant, partially_compliant, non_compliant, or not_applicable), finding_summary, gap_description, existing_control, evidence_quote copied from the internal source, rationale, and confidence from 0 to 1. Never invent evidence. If evidence is missing, choose non_compliant. Use not_applicable only when the clause clearly does not apply. All outputs are AI proposals requiring human confirmation.'},{role:'user',content:'Assessment context:\\n'+JSON.stringify($json)}]}) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "gap-ai",
      "name": "AI Clause-by-Clause Comparison",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        -220
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ai=$input.first().json;\nconst ctx=$('Load Gap Assessment Context').first().json;\nconst req=$('Validate Gap Assessment Request').first().json;\nlet parsed=null;\ntry{parsed=JSON.parse(ai?.choices?.[0]?.message?.content||'{}')}catch(e){parsed=null}\nconst allowed=new Set(['compliant','partially_compliant','non_compliant','not_applicable']);\nconst sectionIds=new Set((ctx.internal_sections||[]).map(s=>String(s.internal_document_section_id)));\nconst byClause=new Map((Array.isArray(parsed?.findings)?parsed.findings:[]).map(f=>[String(f.regulatory_clause_id||''),f]));\nconst findings=(ctx.clauses||[]).map(c=>{\n const f=byClause.get(String(c.regulatory_clause_id))||{};\n const raw=String(f.proposed_outcome||f.outcome||'').toLowerCase();\n const outcome=allowed.has(raw)?raw:'non_compliant';\n const sectionId=sectionIds.has(String(f.internal_document_section_id||''))?String(f.internal_document_section_id):null;\n const confidence=Math.max(0,Math.min(1,Number(f.confidence||0)));\n return {regulatory_clause_id:c.regulatory_clause_id,internal_document_section_id:sectionId,outcome,finding_summary:String(f.finding_summary||('Assessment of clause '+c.clause_number)),gap_description:String(f.gap_description||'No sufficient internal evidence was identified.'),existing_control:String(f.existing_control||''),evidence_quote:String(f.evidence_quote||''),rationale:String(f.rationale||'Human confirmation is required.'),confidence};\n});\nconst outcomes=findings.map(f=>f.outcome);\nconst overall=outcomes.includes('non_compliant')?'non_compliant':outcomes.includes('partially_compliant')?'partially_compliant':outcomes.every(x=>x==='not_applicable')?'not_applicable':'compliant';\nreturn [{json:{title:req.assessment_title,request_id:req.request_id,business_unit:req.business_unit,scope:req.scope,regulatory_document_id:ctx.regulatory_document_id,regulatory_document_version_id:ctx.regulatory_document_version_id,internal_document_id:ctx.internal_document_id,overall_outcome:overall,summary:String(parsed?.summary||'AI clause-by-clause comparison completed. Human confirmation is required.'),ai_model:'gpt-4o-mini',findings,metadata:{regulatory_document_code:req.regulatory_document_code,internal_document_title:ctx.internal_document_title,comparison_method:'grounded_clause_to_internal_section'}}}];"
      },
